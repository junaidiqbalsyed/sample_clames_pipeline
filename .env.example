# Event Hub-level or namespace-level policy with "Send" permission
EVENTHUB_CONNECTION_STRING=Endpoint=sb://sensor-stream.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
EVENTHUB_NAME=telemetry-events

# Azure SQL (source database for Lakeflow Connect)
AZURE_SQL_HOST=<server>.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=<database>
AZURE_SQL_USER=<admin user>
AZURE_SQL_PASSWORD=<admin password>
